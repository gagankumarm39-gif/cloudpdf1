# Application Security & Production Settings (Milestone 10)
# In production on Render, generate a 64-character hex key via: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
SESSION_COOKIE_SECURE_ENABLED=true

# Render Free Web Service Settings
PORT=10000
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# Supabase Cloud Configuration (Milestone 8 & 9)
# Keep backend credentials secure in local .env. Never commit actual keys!
SUPABASE_URL=https://tcqexhpsjaaiikmukzpb.supabase.co
# Note: For backend server-side operations (bypassing client RLS policies safely on server),
# prefer the Supabase Service Role Secret Key in SUPABASE_KEY when uploading/deleting private documents.
SUPABASE_KEY=your-supabase-service-role-or-publishable-key-here
SUPABASE_BUCKET=pdf-documents

# Supabase PostgreSQL Connection String (Milestone 9 & 10)
# Session Mode (Port 5432):
DATABASE_URL=postgresql://postgres.tcqexhpsjaaiikmukzpb:[YOUR-DATABASE-PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres
# Transaction Pooler Mode (Port 6543 - recommended for serverless/high concurrency):
# DATABASE_URL=postgresql://postgres.tcqexhpsjaaiikmukzpb:[YOUR-DATABASE-PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres

# AWS & DynamoDB Configuration (Legacy M4-M7 Coexistence / Fallback)
AWS_REGION=us-east-1
S3_BUCKET_NAME=my-cloud-pdf-bucket
DYNAMODB_TABLE_NAME=CloudPDFDocuments
DYNAMODB_USERS_TABLE=CloudPDFUsers

# Optional local profile or credentials (leave blank on EC2 to use IAM Instance Role)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=
